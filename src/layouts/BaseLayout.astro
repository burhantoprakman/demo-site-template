---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  /** Shown in the browser tab and as the OG title. */
  title: string;
  /** One or two sentences. Used for link previews when shared internally. */
  description: string;
}

const { title, description } = Astro.props;
const banner = import.meta.env.PUBLIC_DEMO_BANNER;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    {banner && <p class="banner">{banner}</p>}
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--space-4);
    top: calc(-1 * var(--space-16));
    background: var(--color-ink);
    color: var(--color-paper);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    z-index: 10;
    transition: top 120ms ease;
  }
  .skip:focus { top: var(--space-4); }

  .banner {
    margin: 0;
    max-width: none;
    background: var(--color-signal);
    color: var(--color-paper);
    text-align: center;
    font-size: var(--size-sm);
    padding: var(--space-2) var(--space-4);
  }
</style>
