---
interface Props {
  /** Say exactly what happens, e.g. 'Read the design doc'. Not 'Learn more'. */
  label: string;
  href: string;
  /** 'primary' for the one main action on a page. */
  variant?: 'primary' | 'secondary';
}
const { label, href, variant = 'primary' } = Astro.props;
---
<a class:list={['cta', variant]} href={href}>{label}</a>

<style>
  .cta {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: var(--size-sm);
    border: 1px solid var(--color-accent);
  }
  .cta.primary { background: var(--color-accent); color: var(--color-paper); }
  .cta.secondary { background: transparent; color: var(--color-accent); }
  .cta:hover { filter: brightness(1.08); }
</style>
