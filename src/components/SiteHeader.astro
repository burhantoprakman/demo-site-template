---
import { site } from '../site.config';
const path = Astro.url.pathname;
---
<header>
  <div class="bar">
    <a href="/" class="brand">
      <span class="name">{site.name}</span>
      <span class="tagline">{site.tagline}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  header { border-bottom: 1px solid var(--color-rule); }
  .bar {
    max-width: var(--layout-wide);
    margin: 0 auto;
    padding: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: baseline;
    justify-content: space-between;
  }
  .brand { text-decoration: none; color: inherit; display: block; }
  .name { font-family: var(--font-display); font-size: var(--size-md); font-weight: 600; display: block; }
  .tagline { color: var(--color-ink-muted); font-size: var(--size-sm); }
  nav ul { display: flex; gap: var(--space-6); list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--color-ink-muted); text-decoration: none; font-size: var(--size-sm); }
  nav a:hover, nav a[aria-current='page'] { color: var(--color-accent); text-decoration: underline; }
</style>
