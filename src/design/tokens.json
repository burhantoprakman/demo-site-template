{
  "$comment": "SOURCE OF TRUTH for all design values. Edit here, then run `npm run tokens` to regenerate src/styles/tokens.css. Never hard-code a colour, size, or font in a component - reference the CSS variable instead.",
  "$replace": "Everything below is a neutral placeholder. Replace with real brand values before first use.",

  "color": {
    "ink":        { "value": "#16202B", "use": "primary text, headings" },
    "ink-muted":  { "value": "#5A6773", "use": "secondary text, captions, metadata" },
    "paper":      { "value": "#FCFCFB", "use": "page background" },
    "paper-sunk": { "value": "#F3F2EF", "use": "recessed surfaces: code blocks, table header rows" },
    "rule":       { "value": "#E2E0DC", "use": "borders, dividers, table cell edges" },
    "accent":     { "value": "#2F6E6B", "use": "links, primary action, active state" },
    "accent-soft":{ "value": "#E6EFEE", "use": "accent-tinted backgrounds" },
    "signal":     { "value": "#B8873A", "use": "warning callouts only - not decoration" }
  },

  "font": {
    "display": {
      "value": "'Source Serif 4', Georgia, 'Times New Roman', serif",
      "use": "headings"
    },
    "body": {
      "value": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "use": "running text, UI"
    },
    "mono": {
      "value": "ui-monospace, SFMono-Regular, 'Cascadia Code', Consolas, monospace",
      "use": "code only"
    }
  },

  "size": {
    "$comment": "Modular scale, ratio 1.25, base 1rem.",
    "xs":   { "value": "0.8rem" },
    "sm":   { "value": "0.9rem" },
    "base": { "value": "1rem" },
    "md":   { "value": "1.25rem" },
    "lg":   { "value": "1.563rem" },
    "xl":   { "value": "1.953rem" },
    "2xl":  { "value": "2.441rem" },
    "3xl":  { "value": "3.052rem" }
  },

  "space": {
    "$comment": "4px base grid. Use these, not arbitrary pixel values.",
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "6": { "value": "1.5rem" },
    "8": { "value": "2rem" },
    "12": { "value": "3rem" },
    "16": { "value": "4rem" },
    "24": { "value": "6rem" }
  },

  "radius": {
    "none": { "value": "0" },
    "sm":   { "value": "3px" },
    "md":   { "value": "6px" }
  },

  "layout": {
    "measure":    { "value": "68ch", "use": "max width of running text - keep under 80 characters" },
    "content":    { "value": "46rem", "use": "standard content column" },
    "wide":       { "value": "72rem", "use": "full-bleed sections, wide tables" }
  }
}
